# ===== 构建与运行产物 =====
/build/
/.gradle/
/run/
/logs/
/build.log

# ===== 本机工具 / 会话残留 =====
# hermes-update-fix：网关状态备份等本机会话残留
# JJI54557149985_obj：与本模组构建无关的对象素材
# x：抓取下来的中间文件
/hermes-update-fix/
/JJI54557149985_obj/
/x/
# DSH 的本地 skill 配置（.dsh/skills/...）是本机 AI 工具的东西，不进仓库
/.dsh/
# 参考用的第三方模组 jar（All Rights Reserved 授权，不分发进仓库；本地留作对照）
/参考/

# ===== 建模会话在仓库根丢下的一次性文件 =====
# MCP 的 save_project 会写根目录（模型源已归档到 art/<name>/）；其余是贴图遮罩、裁剪图、探针 JSON。
# Microsoft/ 是 PowerShell 在本机 cwd 落下的 ModuleAnalysisCache。
/Microsoft/
/.tmp_*
/*.npy

# ===== 开发机游戏日志 =====
# Forge 启动器会在仓库根丢下 `游戏日志 - <版本>-<时间>.log`，是本机运行残留，不进仓库。
/*.log

# ===== 美术工作素材 =====
# 保留台账（*.md）、模型源（*.json / *.bbmodel）与脚本（*.py）；
# 栅格图、贴图渲染、日志、中间产物不进仓库。
/art/**/*.png
/art/**/*.jpg
/art/**/*.jpeg
/art/**/*.psd
/art/**/*.tga
/art/**/*.ogg
/art/**/*.wav
/art/**/*.mp4
/art/**/*.gif
/art/**/*.class
/art/**/*.log
/art/**/*.zip

# ===== Python =====
__pycache__/
*.pyc

# ===== 本机音频源文件 =====
# 《朋友的酒》的原始导入件放在工作区根目录即可，是随包分发那一份的来源；
# 真正进仓库的成品在 src/main/resources/assets/apocalypse_zombies/sounds/music/friends_wine.ogg
/朋友的酒.ogg

# 注意：gradle/wrapper/gradle-wrapper.jar 必须进仓库 —— CI 靠它启动 Gradle。
